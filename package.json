{
  "name": "dsh-router-agent",
  "version": "0.1.5",
  "description": "跨项目匹配、拆分、投递并跟踪 DSH 会话任务的个人总入口",
  "type": "module",
  "main": "./src/host/index.mjs",
  "exports": {
    ".": "./src/host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src/host",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {"optional": true},
    "@deepseek-ai/dsh-typert-protocol": {"optional": true}
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
